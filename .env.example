# Jeton du bot, donné par @BotFather. Format : <identifiant>:<35 caractères>.
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeJetonQuiNeSertAAbsolumen

# Secret partagé du webhook. Telegram le renvoie dans X-Telegram-Bot-Api-Secret-Token à
# chaque appel : c'est la seule chose qui distingue Telegram de n'importe qui d'autre sur
# Internet. Caractères autorisés : A-Z a-z 0-9 _ - ; 32 au minimum ici.
#   openssl rand -base64 48 | tr -d '=+/' | cut -c1-64
TELEGRAM_SECRET_WEBHOOK=remplace-moi-par-une-valeur-aleatoire-de-64-caracteres

# Mot de passe de la base. Sert à composer DATABASE_URL ci-dessous et à initialiser le
# conteneur PostgreSQL — les deux doivent concorder, d'où la variable unique.
#   openssl rand -base64 36 | tr -d '=+/'
MOTDEPASSE_BASE=remplace-moi-par-une-valeur-aleatoire

# Connexion à PostgreSQL. « base » est le nom du service dans compose.yaml, résolu par le
# réseau interne — pas un nom d'hôte à renseigner. En développement hors Docker :
#   DATABASE_URL=postgres://compagnon:test@127.0.0.1:5433/compagnon
DATABASE_URL=postgres://compagnon:${MOTDEPASSE_BASE}@base:5432/compagnon

# Adresse d'écoute du service. Derrière Caddy, on n'expose pas ce port.
ADRESSE_ECOUTE=0.0.0.0:8080

# Domaine public servi par Caddy — sert à composer l'URL du webhook.
DOMAINE=compagnon.exemple.fr
COURRIEL_ACME=toi@exemple.fr

# Racine de l'API Telegram. À ne changer que pour un serveur Bot API local ou un test.
# API_TELEGRAM=https://api.telegram.org

# ---------------------------------------------------------------------------
# Le modèle de langue
# ---------------------------------------------------------------------------
# Racine d'une API compatible OpenAI. C'est la convention que vLLM, TGI et la plupart des
# hébergeurs de GPU exposent — d'où le choix : changer de fournisseur ne change qu'une URL.
#   serverless   https://api.deepinfra.com/v1/openai
#   vLLM dédié   http://vllm:8000/v1
#   poste local  http://127.0.0.1:1234/v1     (LM Studio, Ollama, llama.cpp)
MODELE_API_BASE=https://api.exemple.com/v1

# Clé d'accès du fournisseur. Voyage en en-tête Authorization, jamais dans l'URL — contrairement
# au jeton Telegram. Portée par un type qui ne peut pas l'imprimer (src/secret.rs).
MODELE_API_CLE=remplace-moi-par-la-cle-du-fournisseur

# L'identifiant du modèle demandé. Attention : un serveur peut répondre avec un AUTRE modèle
# sans le dire — mesuré. C'est celui qu'il RENVOIE qui est inscrit dans le registre des coûts.
MODELE_NOM=mistralai/Mistral-Small-3.2-24B-Instruct-2506

# Le nom de l'hébergeur, inscrit tel quel dans consommation.fournisseur. Sert à regrouper des
# montants ; c'est ce qui permet de comparer deux hébergeurs sur des factures réelles.
MODELE_FOURNISSEUR=deepinfra

# Jetons de sortie maximum. 500 ≈ 2000 caractères, largement au-dessus d'un message de
# compagnon. Un modèle À RAISONNEMENT dépense ce budget dans sa réflexion et peut ne rien
# écrire du tout : mesuré, quatre appels sur cinq à 80 jetons rendaient une réponse vide.
# MODELE_JETONS_MAX=500

# Température. Haute à dessein : un compagnon qui répond deux fois la même chose à deux jours
# d'intervalle détruit la continuité que tout le produit cherche à tenir.
# MODELE_TEMPERATURE=0.85

# Délai au-delà duquel l'appel est abandonné, en secondes. Porte sur l'appel entier, pas sur la
# seule connexion : c'est la génération qui est lente.
# MODELE_DELAI_S=60

# Tarifs, en euros par million de jetons. OBLIGATOIRES et sans valeur par défaut : un défaut à
# zéro ferait dire au registre que le service ne coûte rien, et personne ne va vérifier une
# réponse qui arrange. À reprendre sur la page de prix du fournisseur, TVA comprise ou non
# selon ce qu'on veut lire dans les rapports.
MODELE_PRIX_ENTREE_EUR_PAR_MILLION=0.14
MODELE_PRIX_SORTIE_EUR_PAR_MILLION=0.42
