# Jeton du bot, donné par @BotFather. Format : <identifiant>:<35 caractères>.
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeJetonQuiNeSertAAbsolumen

# Secret partagé du webhook. Telegram le renvoie dans X-Telegram-Bot-Api-Secret-Token à
# chaque appel : c'est la seule chose qui distingue Telegram de n'importe qui d'autre sur
# Internet. Caractères autorisés : A-Z a-z 0-9 _ - ; 32 au minimum ici.
#   openssl rand -base64 48 | tr -d '=+/' | cut -c1-64
TELEGRAM_SECRET_WEBHOOK=remplace-moi-par-une-valeur-aleatoire-de-64-caracteres

# Adresse d'écoute du service. Derrière Caddy, on n'expose pas ce port.
ADRESSE_ECOUTE=0.0.0.0:8080

# Domaine public servi par Caddy — sert à composer l'URL du webhook.
DOMAINE=compagnon.exemple.fr
COURRIEL_ACME=toi@exemple.fr

# Racine de l'API Telegram. À ne changer que pour un serveur Bot API local ou un test.
# API_TELEGRAM=https://api.telegram.org
